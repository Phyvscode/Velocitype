# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (falls back to in-memory MongoDB if unreachable in dev)
MONGODB_URI=mongodb://127.0.0.1:27017/velocitype
USE_MEMORY_DB=false

# JWT Authentication Secret (REQUIRED in production, minimum 16 characters)
JWT_SECRET=replace_with_a_strong_32_byte_random_secret

# Allowed Frontend Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth Verification (optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Gemini API Key for Server-Side Sentence Generation Proxy (optional)
GEMINI_API_KEY=your_gemini_api_key

# SMTP Email Configuration for Password Recovery OTPs (optional; falls back to Ethereal in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
